# Enterprise Directory overrides; merge into the deployment environment before release.
# Generic OAuth defaults stay provider-neutral. No credentials belong in this file.
CF_SSO_OAUTH_LOGIN_ID_CLAIM=userId
# Normally no provider setting: trusted Directory /groups?view=entities
# declares the existing namespace (Etech returns etech). Do not set external
# for Etech; that would hide its existing ACL and group mappings.
# Only deployments with an intentionally pinned legacy namespace need an
# explicit override. CF_ACL_PROVIDER remains a supported legacy alias.
# CF_DIRECTORY_PROVIDER=your-existing-provider
# Machine Directory audience defaults to eap-directory on both sides;
# no extra environment override is required for Etech.
# Optional: enable ONLY after the trusted Directory /administrators machine endpoint
# and CE admin ownership have been verified. Uses existing Directory URL/key/secret.
# A failed one-time fetch warns without preventing the CloudFile service startup.
CF_PROVIDER_ADMIN_STARTUP_SYNC_ENABLED=false
# Optional: require one known business administrator account in the signed roster.
# This is a health assertion only; it never grants privileges by username alone.
CF_PROVIDER_ADMIN_EXPECTED_ACCOUNT=

# Organization/role catalog synchronization is EXTERNAL-TRIGGERED only.
# The source application (Etech PowerJob, or another enterprise scheduler) calls
# POST /api/v2.1/admin/cloudfile/directory/entities/sync/ with admin credentials.
# CloudFile does not poll automatically; users are refreshed on authentication.
