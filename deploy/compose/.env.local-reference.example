# Additive overrides for docker-compose.local-reference.yml.
# Copy to .env.local-reference and replace every local-only password/key.

SEAFILE_SERVER_HOSTNAME=cloudfile.localtest.me
SEAFILE_SERVER_PROTOCOL=http
HTTP_PORT=80
INIT_SEAFILE_ADMIN_EMAIL=cfadmin@local.test
INIT_SEAFILE_ADMIN_PASSWORD=change-this-local-cloudfile-password
INIT_SEAFILE_MYSQL_ROOT_PASSWORD=change-this-local-mariadb-password
SEAFILE_MYSQL_DB_PASSWORD=change-this-local-seafile-db-password

AUTHENTIK_TAG=2026.5.7
AUTHENTIK_PG_DB=authentik
AUTHENTIK_PG_USER=authentik
AUTHENTIK_PG_PASS=change-this-local-authentik-db-password
AUTHENTIK_SECRET_KEY=replace-with-a-unique-random-secret-key-at-least-50-characters
AUTHENTIK_HTTP_PORT=9002
# Optional first-start lab automation credentials. Leave empty for web setup.
AUTHENTIK_BOOTSTRAP_PASSWORD=
AUTHENTIK_BOOTSTRAP_TOKEN=

FILESTASH_IMAGE=machines/filestash:latest
REFERENCE_SFTP_IMAGE=atmoz/sftp:latest
REFERENCE_SFTP_PASSWORD=change-this-local-reference-password
FILESTASH_HTTP_PORT=8334

# Fill these after creating a dedicated CloudFile OIDC Provider in Authentik.
CF_ENABLE_SSO=true
CF_SSO_OAUTH_CLIENT_ID=
CF_SSO_OAUTH_CLIENT_SECRET=
CF_SSO_OAUTH_AUTHORIZATION_URL=http://auth.localtest.me:9002/application/o/authorize/
CF_SSO_OAUTH_TOKEN_URL=http://auth.localtest.me:9002/application/o/token/
CF_SSO_OAUTH_USER_INFO_URL=http://auth.localtest.me:9002/application/o/userinfo/
CF_SSO_OAUTH_LOGOUT_URL=http://auth.localtest.me:9002/application/o/cloudfile/end-session/
CF_SSO_OAUTH_PROVIDER=authentik:cloudfile
CF_SSO_OAUTH_SCOPE=openid email profile
CF_SSO_OAUTH_UID_CLAIM=sub
CF_SSO_OAUTH_EMAIL_CLAIM=email
CF_SSO_OAUTH_NAME_CLAIM=name
CF_SSO_OAUTH_INSECURE=true
