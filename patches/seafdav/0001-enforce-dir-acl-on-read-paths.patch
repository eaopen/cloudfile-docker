+#: Permissions that permit reading. Anything else -- including None, which is
+#: what an "invisible" rule resolves to -- hides the entry.
+CF_READABLE_PERMS = ("r", "rw")
+
+
+def cf_readable(repo_id, rel_path, username):
+    """Whether `username` may see `rel_path` at all.
+
+    CloudFile patch. Every write path in this file already goes through
+    check_permission_by_path, but the read paths did not, so a folder that the
+    directory ACL makes invisible was still listed and still readable over
+    WebDAV. A capability that hides a folder everywhere except one protocol
+    does not hide it.
+
+    Fails closed: if the RPC errors we hide the entry rather than show it. A
+    listing that is missing something is a support ticket; a listing that shows
+    something it should not is a disclosure.
+    """
+    try:
+        perm = seafile_api.check_permission_by_path(repo_id, rel_path or "/",
+                                                    username)
+    except SearpcError as e:
+        _logger.warning("cloudfile: permission check failed for %s%s: %s",
+                        repo_id, rel_path, e)
+        return False
+    return perm in CF_READABLE_PERMS
+
 
