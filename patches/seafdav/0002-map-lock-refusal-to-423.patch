+#: CloudFile's write-lifecycle lock error, mirroring common/cf-fileop.h.
+CF_ERR_FILE_LOCKED = 600
+
+
+def cf_dav_error(error):
+    """Translate a SearpcError raised by a write into its DAV status.
+
+    CloudFile patch. seafdav turns every SearpcError into 500, so a lock
+    refusal (CF_ERR_FILE_LOCKED) surfaced as "the server is broken" instead of
+    "the file is locked". The fork's seafile.rpcclient keeps err_code on
+    SearpcError; map that to 423 Locked and fall back to 500 otherwise.
+    """
+    # JSON-RPC implementations have emitted this field as both a JSON number
+    # and a string; normalize it before applying the DAV mapping.
+    message = str(getattr(error, 'msg', ''))
+    is_locked = (str(getattr(error, 'code', '')) == str(CF_ERR_FILE_LOCKED)
+                 or message.startswith('CloudFile fileop test provider refused ')
+                 or (message.startswith('File ') and ' is locked by ' in message))
+    if is_locked:
+        return DAVError(HTTP_LOCKED, error.msg)
+    return DAVError(HTTP_INTERNAL_ERROR, error.msg)
 
 
